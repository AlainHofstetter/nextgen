<!--
  Full-page host for the Abacus Approvals tab. A Lightning Component tab (unlike a
  FlexiPage app page) renders without the automatic "Abacus Approvals" page-header bar,
  which would duplicate the logo/KPI header below. Aura is required here because
  lightning:listView has no LWC equivalent.

  The KPI header LWC sits on top, followed by a tabset of AbacusTransferNG__c list
  views. Tab labels carry live status counts fetched from
  AbacusTransferNGHeaderController.getStatusCounts (refreshed on init and on every
  tab activation). Exactly ONE lightning:listView is alive at any time: each tab
  body is gated by v.rendered.<tab> and activation flips the flags exclusively.
  Multiple concurrent lightning:listView instances on one page crash Lightning
  ("Sorry to interrupt"), so the previous tab's list is destroyed on switch.
-->
<aura:component
  implements="force:appHostable"
  controller="AbacusTransferNGHeaderController"
  access="global"
>
  <!-- exclusive render flags: only the active tab's list view may be alive -->
  <aura:attribute
    name="rendered"
    type="Object"
    default="{ 'pendingApproval': true, 'pending': false, 'inFlight': false, 'failed': false, 'deadLettered': false, 'sent': false, 'all': false }"
  />

  <!-- tab labels, computed from the status counts (safe defaults before data) -->
  <aura:attribute
    name="labels"
    type="Object"
    default="{ 'pendingApproval': 'Pending Approval (0)', 'pending': 'Pending (0)', 'inFlight': 'In Flight (0)', 'failed': 'Failed (0)', 'deadLettered': 'Dead Lettered (0)', 'sent': 'Sent', 'all': 'All' }"
  />

  <!-- whether the status-lifecycle help box is expanded -->
  <aura:attribute name="showHelp" type="Boolean" default="false" />

  <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

  <c:abacusTransferHeader />

  <div class="slds-m-top_x-small">
    <div class="slds-grid slds-grid_align-end slds-m-bottom_xx-small">
      <!-- ignore needed: prettier treats onclick as native-HTML JS and mangles the Aura expression -->
      <!-- prettier-ignore -->
      <lightning:buttonIcon
        iconName="utility:info"
        variant="bare"
        alternativeText="What do the statuses mean?"
        title="What do the statuses mean?"
        onclick="{!c.toggleHelp}"
      />
    </div>

    <aura:if isTrue="{!v.showHelp}">
      <div
        class="slds-box slds-theme_shade slds-m-bottom_small slds-text-body_small"
      >
        <p class="slds-m-bottom_x-small">
          <strong>Transfer lifecycle:</strong>
          Pending Approval &#8594; Pending &#8594; In Flight &#8594; Sent
          &nbsp;(on delivery problems: In Flight &#8594; Failed &#8594; Dead
          Lettered)
        </p>
        <dl class="slds-dl_horizontal">
          <dt class="slds-dl_horizontal__label slds-truncate">
            <strong>Pending Approval</strong>
          </dt>
          <dd class="slds-dl_horizontal__detail">
            Waiting for a finance approver &#8212; release via Approve &amp;
            Push.
          </dd>
          <dt class="slds-dl_horizontal__label slds-truncate">
            <strong>Pending</strong>
          </dt>
          <dd class="slds-dl_horizontal__detail">
            Approved and queued; waiting for MuleSoft to pick it up.
          </dd>
          <dt class="slds-dl_horizontal__label slds-truncate">
            <strong>In Flight</strong>
          </dt>
          <dd class="slds-dl_horizontal__detail">
            MuleSoft is delivering the record to Abacus right now.
          </dd>
          <dt class="slds-dl_horizontal__label slds-truncate">
            <strong>Sent</strong>
          </dt>
          <dd class="slds-dl_horizontal__detail">
            Successfully booked in Abacus (see Sent At / Abacus Document Id).
          </dd>
          <dt class="slds-dl_horizontal__label slds-truncate">
            <strong>Failed</strong>
          </dt>
          <dd class="slds-dl_horizontal__detail">
            The last delivery attempt failed, but MuleSoft keeps retrying
            automatically with increasing back-off (minutes &#8594; hours)
            &#8212; rows here can still complete on their own. Check Last Error
            on the record for details.
          </dd>
          <dt class="slds-dl_horizontal__label slds-truncate">
            <strong>Dead Lettered</strong>
          </dt>
          <dd class="slds-dl_horizontal__detail">
            All automatic retries are exhausted; nothing more happens without
            manual action. Fix the cause, then re-queue the row via Approve
            &amp; Push (replay keeps the original approval stamp). These rows
            are finance/ops to-dos.
          </dd>
          <dt class="slds-dl_horizontal__label slds-truncate">
            <strong>All</strong>
          </dt>
          <dd class="slds-dl_horizontal__detail">
            Every row, including Cancelled (withdrawn before release) and
            Dormant (parked, not yet queued).
          </dd>
        </dl>
      </div>
    </aura:if>

    <lightning:tabset selectedTabId="pendingApproval">
      <lightning:tab
        id="pendingApproval"
        label="{!v.labels.pendingApproval}"
        onactive="{!c.onTabActive}"
      >
        <aura:if isTrue="{!v.rendered.pendingApproval}">
          <lightning:listView
            objectApiName="AbacusTransferNG__c"
            listName="PendingApproval"
            rows="25"
            showActionBar="true"
            enableInlineEdit="true"
            showRowLevelActions="true"
            showSearchBar="true"
          />
        </aura:if>
      </lightning:tab>

      <lightning:tab
        id="pending"
        label="{!v.labels.pending}"
        onactive="{!c.onTabActive}"
      >
        <aura:if isTrue="{!v.rendered.pending}">
          <lightning:listView
            objectApiName="AbacusTransferNG__c"
            listName="Pending"
            rows="25"
            showActionBar="true"
            enableInlineEdit="true"
            showRowLevelActions="true"
            showSearchBar="true"
          />
        </aura:if>
      </lightning:tab>

      <lightning:tab
        id="inFlight"
        label="{!v.labels.inFlight}"
        onactive="{!c.onTabActive}"
      >
        <aura:if isTrue="{!v.rendered.inFlight}">
          <lightning:listView
            objectApiName="AbacusTransferNG__c"
            listName="InFlight"
            rows="25"
            showActionBar="true"
            enableInlineEdit="true"
            showRowLevelActions="true"
            showSearchBar="true"
          />
        </aura:if>
      </lightning:tab>

      <lightning:tab
        id="failed"
        label="{!v.labels.failed}"
        onactive="{!c.onTabActive}"
      >
        <aura:if isTrue="{!v.rendered.failed}">
          <lightning:listView
            objectApiName="AbacusTransferNG__c"
            listName="Failed"
            rows="25"
            showActionBar="true"
            enableInlineEdit="true"
            showRowLevelActions="true"
            showSearchBar="true"
          />
        </aura:if>
      </lightning:tab>

      <lightning:tab
        id="deadLettered"
        label="{!v.labels.deadLettered}"
        onactive="{!c.onTabActive}"
      >
        <aura:if isTrue="{!v.rendered.deadLettered}">
          <lightning:listView
            objectApiName="AbacusTransferNG__c"
            listName="DeadLettered"
            rows="25"
            showActionBar="true"
            enableInlineEdit="true"
            showRowLevelActions="true"
            showSearchBar="true"
          />
        </aura:if>
      </lightning:tab>

      <lightning:tab
        id="sent"
        label="{!v.labels.sent}"
        onactive="{!c.onTabActive}"
      >
        <aura:if isTrue="{!v.rendered.sent}">
          <lightning:listView
            objectApiName="AbacusTransferNG__c"
            listName="Sent"
            rows="25"
            showActionBar="true"
            enableInlineEdit="true"
            showRowLevelActions="true"
            showSearchBar="true"
          />
        </aura:if>
      </lightning:tab>

      <lightning:tab
        id="all"
        label="{!v.labels.all}"
        onactive="{!c.onTabActive}"
      >
        <aura:if isTrue="{!v.rendered.all}">
          <lightning:listView
            objectApiName="AbacusTransferNG__c"
            listName="All"
            rows="25"
            showActionBar="true"
            enableInlineEdit="true"
            showRowLevelActions="true"
            showSearchBar="true"
          />
        </aura:if>
      </lightning:tab>
    </lightning:tabset>
  </div>
</aura:component>

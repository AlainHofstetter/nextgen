public class AbacusTransferNGStaffHourBatch implements Database.Batchable<SObject>, Database.Stateful {
  // Creates one AbacusTransferNG__c row per BillingReceiver Account for the configured window
  // (defaults to last calendar week). Per-row payload is generated by Mule via DataWeave from the
  // Time__c records inside the window — Salesforce only emits the trigger.
  //
  // TODO (Discovery 1 confirmed no legacy batch exists in the repo): refine the grouping dimension
  // (Account vs Project vs Employee) and the date field (DateFrom__c vs CreatedDate) per finance
  // requirements. Current contract: group by BillingReceiver__c over [fromDt, untilDt] inclusive.

  // Only Swiss entities are on Abacus — items billed via any other group company must not queue.
  @TestVisible
  private static final Set<Decimal> SWISS_LEGAL_CODES = new Set<Decimal>{
    10,
    25,
    35,
    45,
    55,
    65,
    75,
    90,
    100
  };

  private final DateTime fromDt;
  private final DateTime untilDt;

  public AbacusTransferNGStaffHourBatch() {
    // Monday-anchored regardless of the running user's locale — Date.toStartOfWeek()
    // returns Sunday for en_US users, which would shift the window Mule re-derives.
    Date today = Date.today();
    Date anchorMonday = Date.newInstance(2024, 1, 1); // a known Monday
    Date thisMonday = today.addDays(
      -Math.mod(anchorMonday.daysBetween(today), 7)
    );
    Date lastMonday = thisMonday.addDays(-7);
    Date lastSunday = lastMonday.addDays(6);
    this.fromDt = DateTime.newInstance(
      lastMonday,
      Time.newInstance(0, 0, 0, 0)
    );
    this.untilDt = DateTime.newInstance(
      lastSunday,
      Time.newInstance(23, 59, 59, 999)
    );
  }

  public AbacusTransferNGStaffHourBatch(DateTime fromDt, DateTime untilDt) {
    this.fromDt = fromDt;
    this.untilDt = untilDt;
  }

  public Database.QueryLocator start(Database.BatchableContext bc) {
    Date fromDate = this.fromDt.date();
    Date untilDate = this.untilDt.date();
    Set<Decimal> legalCodes = SWISS_LEGAL_CODES;
    return Database.getQueryLocator(
      [
        SELECT Id, BillingReceiver__c
        FROM Time__c
        WHERE
          DateFrom__c >= :fromDate
          AND DateFrom__c <= :untilDate
          AND BillingReceiver__c != NULL
          AND BillingViaCompany__r.LegalCode__c IN :legalCodes
      ]
    );
  }

  public void execute(Database.BatchableContext bc, List<Time__c> scope) {
    enqueueForReceivers(collectBillingReceivers(scope));
  }

  public void finish(Database.BatchableContext bc) {
    // No-op.
  }

  @TestVisible
  private static Set<Id> collectBillingReceivers(List<Time__c> scope) {
    Set<Id> result = new Set<Id>();
    for (Time__c t : scope) {
      if (t.BillingReceiver__c != null)
        result.add(t.BillingReceiver__c);
    }
    return result;
  }

  @TestVisible
  private static void enqueueForReceivers(Set<Id> billingReceiverIds) {
    if (billingReceiverIds.isEmpty())
      return;

    Set<Id> alreadyQueued = new Set<Id>();
    for (AbacusTransferNG__c existing : [
      SELECT Account__c
      FROM AbacusTransferNG__c
      WHERE
        InterfaceType__c = 'Staff Hour Export'
        AND Account__c IN :billingReceiverIds
        AND Status__c IN ('Dormant', 'Pending', 'InFlight')
    ]) {
      alreadyQueued.add(existing.Account__c);
    }

    List<AbacusTransferNG__c> rows = new List<AbacusTransferNG__c>();
    for (Id receiverId : billingReceiverIds) {
      if (alreadyQueued.contains(receiverId))
        continue;
      rows.add(
        new AbacusTransferNG__c(
          InterfaceType__c = 'Staff Hour Export',
          Direction__c = 'Outbound',
          Status__c = 'Pending',
          Account__c = receiverId,
          SourceObject__c = 'Time__c'
        )
      );
    }
    if (!rows.isEmpty())
      insert rows;
  }
}

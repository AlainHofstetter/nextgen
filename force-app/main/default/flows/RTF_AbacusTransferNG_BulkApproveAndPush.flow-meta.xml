<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>callReplay</name>
        <label>Publish AbacusTransferNGQueued PEs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>AbacusTransferNGReplayAction</actionName>
        <actionType>apex</actionType>
        <connector><targetReference
      >checkReplayOutcome</targetReference></connector>
        <faultConnector><targetReference
      >errorScreen</targetReference></faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>abacusTransferNGIds</name>
            <value><elementReference
        >callSummary.eligibleIds</elementReference></value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>callSummary</name>
        <label>Compute approval summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>AbacusTransferNGApprovalSummaryAction</actionName>
        <actionType>apex</actionType>
        <connector><targetReference>confirmScreen</targetReference></connector>
        <faultConnector><targetReference
      >errorScreen</targetReference></faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>abacusTransferNGIds</name>
            <value><elementReference>ids</elementReference></value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>60.0</apiVersion>
    <decisions>
        <name>checkReplayOutcome</name>
        <label>Any rows blocked?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>All released</defaultConnectorLabel>
        <rules>
            <name>someBlocked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>callReplay.blockedCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue><numberValue>0.0</numberValue></rightValue>
            </conditions>
            <connector><targetReference
        >blockedScreen</targetReference></connector>
            <label>Blocked rows</label>
        </rules>
    </decisions>
    <description
  >Bulk approval from the list view now shows a single confirmation page with the eligible-row count and the selected invoices' CHF amounts grouped by legal entity (via AbacusTransferNGApprovalSummaryAction), the Finish button reads "Send to Abacus", and on finish the flow releases the rows via AbacusTransferNGReplayAction and returns to the list view.</description>
    <label>RTF AbacusTransferNG Bulk Approve And Push</label>
    <processType>Flow</processType>
    <screens>
        <name>confirmScreen</name>
        <label>Confirm bulk approval</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>callReplay</targetReference></connector>
        <fields>
            <name>confirmText</name>
            <fieldText
      >&lt;p&gt;&lt;img src="/resource/abacus_logo" alt="Abacus" height="64" /&gt;&lt;/p&gt;&lt;p&gt;Approve and release &lt;b&gt;{!callSummary.eligibleCount}&lt;/b&gt; row(s) in &lt;b&gt;Pending Approval&lt;/b&gt; to Abacus?&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>summaryText</name>
            <fieldText>{!callSummary.summaryHtml}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Send to Abacus</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>blockedScreen</name>
        <label>Some rows not sent to Abacus</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>blockedText</name>
            <fieldText
      >&lt;p&gt;&lt;img src="/resource/abacus_logo" alt="Abacus" height="64" /&gt;&lt;/p&gt;&lt;p&gt;Released &lt;b&gt;{!callReplay.releasedCount}&lt;/b&gt; row(s) to Abacus. &lt;b&gt;{!callReplay.blockedCount}&lt;/b&gt; row(s) were &lt;b&gt;not&lt;/b&gt; sent because their customer does not exist in Abacus yet:&lt;/p&gt;&lt;p&gt;{!callReplay.blockedReason}&lt;/p&gt;&lt;p&gt;Blocked rows stay in Pending Approval. Approve &amp;amp; push them again once the customer has been transferred.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>errorScreen</name>
        <label>Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>errorText</name>
            <fieldText
      >&lt;p&gt;&lt;img src="/resource/abacus_logo" alt="Abacus" height="64" /&gt;&lt;/p&gt;&lt;p&gt;The bulk approval failed:&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>callSummary</targetReference></connector>
    </start>
    <status>Active</status>
    <variables>
        <name>ids</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>

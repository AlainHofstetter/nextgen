<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>NG path: stamps IdempotencyKey__c = Name (the auto-number) on newly created AbacusTransferNG__c rows that don't already carry a key, so Mule can send the Idempotency-Key header from the row and address status callbacks via the IdempotencyKey__c external id. Inbound rows created by AbacusTransferNGInboundRest arrive with the caller's key and are skipped.</description>
    <label>RTF AbacusTransferNG StampIdempotencyKey</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>stampKey</name>
        <label>Stamp IdempotencyKey from Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>IdempotencyKey__c</field>
            <value><elementReference>$Record.Name</elementReference></value>
        </inputAssignments>
        <object>AbacusTransferNG__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>stampKey</targetReference></connector>
        <filterFormula>ISBLANK($Record.IdempotencyKey__c)</filterFormula>
        <object>AbacusTransferNG__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

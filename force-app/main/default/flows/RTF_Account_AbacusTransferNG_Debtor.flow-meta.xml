<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>NG path: enqueues an AbacusTransferNG__c row when an Account becomes (or remains) an Abacus Debtor with changed billing details. Mirrors entry conditions of AbacusInterfaceAccountUpsert (legacy).</description>
    <label>RTF Account AbacusTransferNG Debtor</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>createNGRow</name>
        <label>Create AbacusTransferNG row</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Account__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Direction__c</field>
            <value><stringValue>Outbound</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>InterfaceType__c</field>
            <value><stringValue>Account Debtor Upsert</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceObject__c</field>
            <value><stringValue>Account</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceRecordId__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value><stringValue>PendingApproval</stringValue></value>
        </inputAssignments>
        <object>AbacusTransferNG__c</object>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>createNGRow</targetReference></connector>
        <filterFormula>OR(AND(PRIORVALUE($Record.AbacusDebtor__c) = FALSE, $Record.AbacusDebtor__c = TRUE), AND($Record.AbacusDebtor__c = TRUE, OR(ISCHANGED($Record.Name), ISCHANGED($Record.BillingCity__c), ISCHANGED($Record.BillingZip__c), ISCHANGED($Record.BillingStreetNr__c), ISCHANGED($Record.BillingPoBox__c), ISCHANGED($Record.BillingAddressLine2__c), ISCHANGED($Record.BillingAddressLine3__c))))</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

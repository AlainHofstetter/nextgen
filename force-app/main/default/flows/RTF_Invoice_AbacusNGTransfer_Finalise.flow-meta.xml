<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>NG path: when Mule has stamped Invoice__c.AbacusNGTransfer__c on a successful Abacus REST send, transition InvoiceStatus__c to Sent. NG counterpart to legacy InvoiceStatusSentToAbacusWhenTransferDateNotNull (untouched). Whichever path stamps first wins.</description>
    <label>RTF Invoice AbacusNGTransfer Finalise</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>setInvoiceStatusSent</name>
        <label>Set InvoiceStatus to Sent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>InvoiceStatus__c</field>
            <value><stringValue>Sent</stringValue></value>
        </inputAssignments>
        <object>Invoice__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>setInvoiceStatusSent</targetReference></connector>
        <filterFormula>AND(ISBLANK(PRIORVALUE($Record.AbacusNGTransfer__c)), NOT(ISBLANK($Record.AbacusNGTransfer__c)), $Record.InvoiceStatus__c &lt;&gt; "Sent")</filterFormula>
        <object>Invoice__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description
  >NG path: enqueues an AbacusTransferNG__c row when an Invoice&apos;s InvoiceStatus__c changes to Ready. Scope: only invoices billed via an allowlisted legal entity; excludes ILV invoices and cancellation invoices.</description>
    <label>RTF Invoice AbacusTransferNG</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>createNGRow</name>
        <label>Create AbacusTransferNG row</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Direction__c</field>
            <value>
                <stringValue>Outbound</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>InterfaceType__c</field>
            <value>
                <stringValue>Invoice Export</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Invoice__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceObject__c</field>
            <value>
                <stringValue>Invoice__c</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceRecordId__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>PendingApproval</stringValue>
            </value>
        </inputAssignments>
        <object>AbacusTransferNG__c</object>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>createNGRow</targetReference>
        </connector>
        <filterFormula
    >AND(ISPICKVAL({!$Record.InvoiceStatus__c}, &quot;Ready&quot;), NOT(ISPICKVAL(PRIORVALUE({!$Record.InvoiceStatus__c}), &quot;Ready&quot;)), ISBLANK({!$Record.CancellationDate__c}), ISBLANK({!$Record.CancellationInvoiceRelation__c}), {!$Record.RecordType.DeveloperName} &lt;&gt; &quot;ILV&quot;, CONTAINS(&quot;|10|25|35|45|55|65|75|90|100|&quot;, &quot;|&quot; &amp; TEXT({!$Record.BillingViaCompany__r.LegalCode__c}) &amp; &quot;|&quot;))</filterFormula>
        <object>Invoice__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>

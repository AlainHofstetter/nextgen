<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>NG path: if an Invoice&apos;s InvoiceStatus__c moves away from Ready before the transfer is released to Mule, transition any not-yet-sent AbacusTransferNG__c rows (PendingApproval or Pending) for this Invoice to Cancelled.</description>
    <label>RTF Invoice AbacusTransferNG Cancel</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>cancelNGRows</name>
        <label>Cancel open NG rows for this Invoice</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>Invoice__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PendingApproval</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </inputAssignments>
        <object>AbacusTransferNG__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>cancelNGRows</targetReference>
        </connector>
        <filterFormula>AND(ISPICKVAL(PRIORVALUE({!$Record.InvoiceStatus__c}), &quot;Ready&quot;), NOT(ISPICKVAL({!$Record.InvoiceStatus__c}, &quot;Ready&quot;)))</filterFormula>
        <object>Invoice__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>

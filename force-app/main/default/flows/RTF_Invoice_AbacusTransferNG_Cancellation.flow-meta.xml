<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>NG path: enqueues an AbacusTransferNG__c row of type Cancellation Export when an Invoice cancellation is approved. TODO: confirm the exact field/record-type discriminator for "cancellation" vs regular invoice in this org. Current trigger uses AbacusInterfaceExport__c true on a cancellation-marked invoice — adjust the filter to match the actual cancellation field (e.g. a CancellationInvoice__c flag or RecordType).</description>
    <label>RTF Invoice AbacusTransferNG Cancellation</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>createNGRow</name>
        <label>Create AbacusTransferNG row (Cancellation)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Invoice__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Direction__c</field>
            <value><stringValue>Outbound</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>InterfaceType__c</field>
            <value><stringValue>Cancellation Export</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceObject__c</field>
            <value><stringValue>Invoice__c</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceRecordId__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value><stringValue>Pending</stringValue></value>
        </inputAssignments>
        <object>AbacusTransferNG__c</object>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>createNGRow</targetReference></connector>
        <filterFormula>AND(PRIORVALUE($Record.AbacusInterfaceExport__c) = FALSE, $Record.AbacusInterfaceExport__c = TRUE, $Record.InvoiceCancellation__c = TRUE)</filterFormula>
        <object>Invoice__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>

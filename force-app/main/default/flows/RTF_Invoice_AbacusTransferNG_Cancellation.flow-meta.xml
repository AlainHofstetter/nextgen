<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description
  >NG path: enqueues an AbacusTransferNG__c row of type Cancellation Export at PendingApproval (FinanceQueue gate, per the approval table in Abacus_Transfer_NG.md) as soon as the Cancel Invoice action creates a cancellation invoice. Discriminator: CancellationInvoiceRelation__c set on create — only the Apex cancel path writes it (the sibling RTF_Invoice_AbacusTransferNG excludes exactly these records). Scope: only cancellations of non-ILV invoices billed via an allowlisted legal entity.</description>
    <label>RTF Invoice AbacusTransferNG Cancellation</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>createNGRow</name>
        <label>Create AbacusTransferNG row (Cancellation)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Invoice__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Direction__c</field>
            <value><stringValue>Outbound</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>InterfaceType__c</field>
            <value><stringValue>Cancellation Export</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceObject__c</field>
            <value><stringValue>Invoice__c</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceRecordId__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value><stringValue>PendingApproval</stringValue></value>
        </inputAssignments>
        <object>AbacusTransferNG__c</object>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>createNGRow</targetReference></connector>
        <filterFormula
    >AND(NOT(ISBLANK($Record.CancellationInvoiceRelation__c)), $Record.CancellationInvoiceRelation__r.RecordType.DeveloperName &lt;&gt; &quot;ILV&quot;, CONTAINS(&quot;|10|25|35|45|55|65|75|90|100|&quot;, &quot;|&quot; &amp; TEXT($Record.BillingViaCompany__r.LegalCode__c) &amp; &quot;|&quot;))</filterFormula>
        <object>Invoice__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
